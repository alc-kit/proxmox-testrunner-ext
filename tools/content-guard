#!/usr/bin/env python3
"""Keep this public repository free of private details.

Refuses private IPv4 addresses and internal host names (built in), and NAMES that must never
appear here: customers, hosts, fleets. Those names are never written in this repository (that
would publish them): they come from CONTENT_GUARD_NAMES (one per line, or comma-separated), or
from ~/.config/content-guard/names. With --require-names the guard fails when no names were
given, so it never reports "clean" without them. It is an optional local tool: nothing runs it.

Scans every tracked file (or the paths given). Exit 0 clean, 1 findings, 2 refused.
"""
import os
import re
import subprocess
import sys
from pathlib import Path

GENERIC = {
    "private IPv4 address": r"\b(?:10\.\d{1,3}|192\.168|172\.(?:1[6-9]|2\d|3[01]))\.\d{1,3}\.\d{1,3}\b",
    "internal host name": r"\b[\w-]+\.(?:internal|intranet|corp|lan)\b",
}
NAMES_FILE = Path.home() / ".config" / "content-guard" / "names"


def names() -> list[str]:
    raw = os.environ.get("CONTENT_GUARD_NAMES") or (NAMES_FILE.read_text() if NAMES_FILE.is_file() else "")
    return [n.strip() for n in re.split(r"[\n,]", raw) if n.strip() and not n.strip().startswith("#")]


def main(argv):
    require = "--require-names" in argv
    argv = [a for a in argv if a != "--require-names"]
    forbidden = names()
    if require and not forbidden:
        print("content-guard: --require-names, but no names were given (CONTENT_GUARD_NAMES or "
              f"{NAMES_FILE}) — refusing to report 'clean'", file=sys.stderr)
        return 2
    patterns = {k: re.compile(v) for k, v in GENERIC.items()}
    for n in forbidden:
        patterns[f"forbidden name #{forbidden.index(n) + 1}"] = re.compile(r"(?<![\w-])" + re.escape(n) + r"(?![\w-])",
                                                                          re.IGNORECASE)
    paths = argv or subprocess.run(["git", "ls-files"], capture_output=True, text=True, check=True).stdout.split()
    found = 0
    for path in paths:
        if path == "tools/content-guard":
            continue
        try:
            text = open(path, encoding="utf-8", errors="replace").read()
        except (IsADirectoryError, FileNotFoundError):
            continue
        for lineno, line in enumerate(text.splitlines(), 1):
            for label, rx in patterns.items():
                if rx.search(line):
                    # a forbidden name is reported by its number, never printed (the log is public)
                    shown = line.strip()[:120] if not label.startswith("forbidden") else "(line withheld)"
                    print(f"{path}:{lineno}: {label}: {shown}")
                    found += 1
    print(f"content-guard: {found} finding(s) in {len(paths)} file(s); {len(forbidden)} forbidden name(s) checked",
          file=sys.stderr)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
